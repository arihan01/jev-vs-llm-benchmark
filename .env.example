# Copy to .env (gitignored) and fill in:  cp .env.example .env
# `make check` (lint, types, tests) needs no key; only live runs do.

# REQUIRED. The only key this benchmark needs: every engine (Jev, Qwen, GPT-6 Luna,
# Claude Opus 5.5) and the perturbation generator are called through OpenRouter.
#   1. Sign in at https://openrouter.ai
#   2. Settings -> Keys (https://openrouter.ai/settings/keys) -> Create Key
#   3. Settings -> Credits (https://openrouter.ai/settings/credits): top up ~$10
#      (full benchmark is ~$4; credits also lift free-model rate limits)
# No OpenAI or Anthropic key is needed; OpenRouter resells those models.
OPENROUTER_API_KEY=sk-or-v1-...

# FREE TRIAL ONLY (config.free.yaml). Calls Jev on TypeSafe directly, because
# OpenRouter has no free Jev. Not needed for the default config.yaml.
#   1. Sign up at https://console.typesafe.ai (check whether a sign-up credit shows)
#   2. Settings -> API keys (https://console.typesafe.ai/settings/keys) -> Create key
TYPESAFE_API_KEY=apikey_...

# OPTIONAL. Hugging Face token. The three datasets are public and need no login;
# set this only if you hit anonymous download rate limits.
#   https://huggingface.co/settings/tokens -> New token (type: Read)
# HF_TOKEN=hf_...
